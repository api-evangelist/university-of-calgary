          "id": "39838eec-fbc2-47b5-803e-1bec2e688cd6",
          "name": "Retrieve terminator coordinates",
          "request": {
            "name": "Retrieve terminator coordinates",
            "description": {
              "content": "Retrieve coordinates for the terminator. \n\nThe timestamp parameter should be supplied in the format \"YYYY-MM-DDTHH:mm:ss\". \nUTC is the expected timezone.\n\nThe angle parameter is used for retrieving the terminator for civil, nautical, \nor astronomical twilight. Use the values -6.0, -12.0, or -18.0 for each of these \nterminators, respectively.\n\nNotes:\n  - The algorithm does not account for altitude at this time\n  - By default requests are cached. Use the 'no_cache' parameter to disable this functionality.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "utils",
                "terminator"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "angle",
                  "value": "-12"
                },
                {
                  "disabled": false,
                  "key": "no_cache",
                  "value": "false"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
