        {
          "id": "bed97874-d6e7-41f7-a51f-6d4615b8f5ef",
          "name": "Retrieve geomagnetic coordinate grid",
          "request": {
            "name": "Retrieve geomagnetic coordinate grid",
            "description": {
              "content": "Retrieve a geomagnetic coordinate grid for a given timestamp.\n\nThe timestamp parameter should be supplied in the format \"YYYY-MM-DDTHH:mm:ss\". \nUTC is the expected timezone.\n\nThe grid consists of meridian lines (constant magnetic longitude, \"vertical\") and parallel lines\n(constant magnetic latitude, \"horizontal\") for both northern and southern hemispheres.\n\nNotes\n  - The resolution_lon and resolution_lat parameters control the spacing (in degrees) between\nmagnetic longitude and latitude lines, respectively. Lower values produce a denser grid.\n  - By default requests are cached. Use the 'no_cache' parameter to disable this functionality.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "utils",
                "magnetic_grid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "resolution_lon",
                  "value": "10"
                },
                {
                  "disabled": false,
                  "key": "resolution_lat",
                  "value": "5"
                },
                {
                  "disabled": false,
                  "key": "min_latitude",
                  "value": "50"
                },
                {
                  "disabled": false,
                  "key": "altitude_km",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "no_cache",
                  "value": "false"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
