        {
          "id": "d1e5f978-f361-4811-bde9-647b25aa114c",
          "name": "Retrieve latest data for a real-time stream",
          "request": {
            "name": "Retrieve latest data for a real-time stream",
            "description": {
              "content": "Retrieve the latest data for a given real-time data stream.\n\nNotes:\n  - The `id` can be determined by using the stream listing endpoint.\n  - The response content type depends on the stream's mimetype (e.g., image/jpeg).\n  - Data is sourced from the database, populated by the RT ingester services.\n  - The response includes an `x-rt-stream-last-updated-utc` header with the ISO 8601 UTC timestamp of when the stream data was last updated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "rt",
                ":id",
                "latest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "countdown_clock",
                  "value": "false",
                  "description": "Show countdown clock when not imaging"
