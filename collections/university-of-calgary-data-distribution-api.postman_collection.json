        {
          "id": "1b408f71-415f-4193-9a56-b4c59ffe5311",
          "name": "Retrieve imaging start and end times for a set of locations",
          "request": {
            "name": "Retrieve imaging start and end times for a set of locations",
            "description": {
              "content": "Retrieve imaging start and end times for a set of locations. This is specific to the optical \ninstrumentation we provide data for.\n\nThe timestamp is expected to be UTC time.\n\nEach location in the 'locations' array can be specified either by a 4-letter site UID, or by\nproviding geodetic latitude and longitude. If the site_uid is provided, it is resolved to\ncoordinates using the known observatory list.\n\nNotes:\n  - The threshold parameter is the solar zenith angle (in degrees) above which imaging occurs. \n    The default value of 102.0 corresponds to nautical twilight, and what all UCalgary optical\n    instruments use.\n  - The `site_uid` parameter matching is case insensitive",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "data_distribution",
                "imaging_timeframes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"<dateTime>\",\n  \"locations\": [\n    {\n      \"site_uid\": \"<string>\",\n      \"geodetic_latitude\": \"<number>\",\n      \"geodetic_longitude\": \"<number>\"\n    },\n    {\n      \"site_uid\": \"<string>\",\n      \"geodetic_latitude\": \"<number>\",\n      \"geodetic_longitude\": \"<number>\"\n    }\n  ],\n  \"threshold\": 102\n}",
